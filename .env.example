# Токен от @BotFather
BOT_TOKEN=
# Имя бота без @ (если пусто, узнаём через getMe)
BOT_USERNAME=
# Короткое имя мини-приложения из @BotFather (/newapp), для ссылок t.me/<bot>/<app>?startapp=
APP_SHORT_NAME=
# Публичный HTTPS-адрес этого сервера: мини-приложение, API и картинки для шеринга
WEBAPP_URL=https://example.com/
HOST=0.0.0.0
PORT=8080
# Админка: Telegram ID через запятую и секрет TOTP (base32) для второго фактора
ADMIN_IDS=
ADMIN_TOTP_SECRET=
# Канал для публикации розыгрышей (@channel или -100…), бот должен быть админом
RAFFLE_CHANNEL=
# 1 — каждый день в 04:00 МСК пересобирать цены и курс ЦБ (tools/build_catalog.py)
PRICE_UPDATE=0
# 1 — пускать запросы без подписи Telegram (только для разработки)
DEV_MODE=0
